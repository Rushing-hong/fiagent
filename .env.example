DEEPSEEK_API_KEY=your_api_key_here
# Optional DeepSeek endpoint override
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Other OpenAI-compatible providers (set the key for models you use) ---
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# MOONSHOT_API_KEY=
# Official: https://api.moonshot.ai/v1  (CN: https://api.moonshot.cn/v1)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Claude: use an OpenAI-compatible gateway (set ANTHROPIC_BASE_URL)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-openai-compatible-claude-gateway/v1

FIAGENT_TZ=Asia/Shanghai
FIAGENT_MAX_TOOL_ROUNDS=10
# Unsafe: permits the run_python tool to execute arbitrary local Python with
# your user permissions. Leave disabled unless this is a trusted dev workspace.
# FIAGENT_ENABLE_RUN_PYTHON=1
# LLM streaming timeouts (seconds) — thinking models may idle before first chunk
# FIAGENT_LLM_CONNECT_TIMEOUT=30
# FIAGENT_LLM_READ_TIMEOUT=600
# FIAGENT_LLM_WRITE_TIMEOUT=120
# FIAGENT_LLM_STREAM_RETRIES=2
# Sub-agents use non-stream by default (FIAGENT_SUBAGENT_STREAM=1 to force SSE)
# FIAGENT_LLM_MAX_PARALLEL=2
